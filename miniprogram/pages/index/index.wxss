/**index.wxss**/
page {
  height: 100vh;
  background-color: #f5f5f5;
}

.page-container {
  height: 100vh;
  position: relative;
}

.scroll-area {
  height: 100%;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 瀑布流布局 */
.masonry {
  display: flex;
  gap: 16rpx;
}

.masonry-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-image {
  width: 100%;
  display: block;
}

.card-info {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.author-name {
  font-size: 24rpx;
  color: #8b8b8b;
}

.like-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-count {
  font-size: 24rpx;
  color: #a6a6a6;
}

/* 加载更多 */
.loading-more {
  padding: 32rpx 0 120rpx;
  display: flex;
  justify-content: center;
}

/* 悬浮按钮 */
.fab-button {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.95);
  opacity: 0.9;
}
