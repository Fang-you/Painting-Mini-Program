/**index.wxss**/
page {
  height: 100vh;
  background-color: #f5f5f5;
}

.page-container {
  height: 100vh;
  position: relative;
}

.scroll-area {
  height: 100%;
  padding: 16rpx;
  box-sizing: border-box;
}

.empty-state {
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 两列网格布局 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-image {
  width: 100%;
  display: block;
}

.card-info {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.author-avatar-placeholder {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.author-name {
  font-size: 24rpx;
  color: #8b8b8b;
}

.like-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-count {
  font-size: 24rpx;
  color: #a6a6a6;
}

/* 加载更多 */
.loading-more {
  padding: 32rpx 0 120rpx;
  display: flex;
  justify-content: center;
}

/* 悬浮按钮 */
.fab-button {
  position: fixed;
  right: 32rpx;
  bottom: 300rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 画作详情弹窗 */
.detail-popup {
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.detail-close {
  padding: 8rpx;
}

.detail-image-wrap {
  width: 100%;
  background: #f5f5f5;
}

.detail-image {
  width: 100%;
  display: block;
}

.detail-author {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-author-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.detail-prompt {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.detail-prompt-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.detail-prompt-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}
