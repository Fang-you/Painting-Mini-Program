<!--index.wxml-->
<view class="page-container">
  <!-- 瀑布流画作列表 -->
  <scroll-view 
    class="scroll-area" 
    scroll-y 
    enhanced 
    show-scrollbar="{{false}}"
    bindscrolltolower="onLoadMore"
  >
    <view class="masonry">
      <!-- 左列 -->
      <view class="masonry-column">
        <block wx:for="{{leftColumn}}" wx:key="id">
          <view class="card" bindtap="onCardTap" data-id="{{item.id}}">
            <image 
              class="card-image" 
              src="{{item.imageUrl}}" 
              mode="widthFix"
              lazy-load
            />
            <view class="card-info">
              <view class="author-info">
                <view class="avatar" style="background: {{item.avatarColor}};"></view>
                <text class="author-name">{{item.authorName}}</text>
              </view>
              <view class="like-info">
                <t-icon name="heart" size="32rpx" color="#a6a6a6" />
                <text class="like-count">{{item.likeCount}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
      <!-- 右列 -->
      <view class="masonry-column">
        <block wx:for="{{rightColumn}}" wx:key="id">
          <view class="card" bindtap="onCardTap" data-id="{{item.id}}">
            <image 
              class="card-image" 
              src="{{item.imageUrl}}" 
              mode="widthFix"
              lazy-load
            />
            <view class="card-info">
              <view class="author-info">
                <view class="avatar" style="background: {{item.avatarColor}};"></view>
                <text class="author-name">{{item.authorName}}</text>
              </view>
              <view class="like-info">
                <t-icon name="heart" size="32rpx" color="#a6a6a6" />
                <text class="like-count">{{item.likeCount}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>
  </scroll-view>

  <!-- 悬浮按钮 -->
  <view class="fab-button" bindtap="onCreateTap">
    <t-icon name="add" size="56rpx" color="#ffffff" />
  </view>
</view>
