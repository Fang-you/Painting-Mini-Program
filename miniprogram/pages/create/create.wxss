/**create.wxss**/
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-container {
  padding: 32rpx;
  padding-bottom: 60rpx;
}

/* 风格标签区 */
.style-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.style-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-tag {
  --td-tag-outline-bg-color: #f5f5f5;
  --td-tag-outline-color: #666666;
  --td-tag-large-padding: 12rpx 24rpx;
  --td-tag-large-font-size: 26rpx;
  --td-tag-border-radius: 32rpx;
}

.style-tag-active {
  --td-tag-primary-color: #7941e2;
  --td-tag-primary-bg-color: #667eea;
}

/* 输入区域 */
.input-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}

.prompt-textarea {
  --td-textarea-background-color: #f5f5f5;
  --td-textarea-border-radius: 16rpx;
}

/* 生成按钮 */
.generate-btn {
  margin-bottom: 32rpx;
  --td-button-primary-bg-color: #5a67d8;
  --td-button-primary-border-color: #5a67d8;
  --td-button-border-radius: 24rpx;
  --td-button-large-height: 100rpx;
  --td-button-large-font-size: 32rpx;
}

/* 加载状态 */
.loading-section {
  margin-bottom: 32rpx;
}

.loading-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.loading-text {
  font-size: 32rpx;
  color: #333333;
  margin-top: 32rpx;
}

.loading-tip {
  font-size: 24rpx;
  color: #a6a6a6;
  margin-top: 16rpx;
}

/* 结果区域 */
.result-section {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.result-header {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeeee;
}

.result-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.ai-tag {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 图片预览 */
.image-preview {
  width: 100%;
  background: #eef2ff;
}

.generated-image {
  width: 100%;
  display: block;
}

/* 提示词显示 */
.prompt-display {
  padding: 32rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.prompt-label {
  font-size: 24rpx;
  color: #a6a6a6;
  display: block;
  margin-bottom: 12rpx;
}

.prompt-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 发布按钮 */
.publish-btn {
  margin: 32rpx;
  --td-button-primary-bg-color: #667eea;
  --td-button-primary-border-color: #667eea;
  --td-button-border-radius: 24rpx;
  --td-button-large-height: 100rpx;
  --td-button-large-font-size: 32rpx;
}
