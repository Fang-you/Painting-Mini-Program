/**profile.wxss**/
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
}

/* 用户信息区 */
.user-section {
  background: #ffffff;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.avatar-wrapper {
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.avatar-button {
  padding: 0;
  background: transparent;
  line-height: normal;
}

.avatar-button::after {
  border: none;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: bold;
}

.user-detail {
  flex: 1;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.work-count {
  font-size: 26rpx;
  color: #8b8b8b;
}

.settings-btn {
  padding: 16rpx;
}

/* 未登录状态 */
.unlogged-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.default-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #eeeeee;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.unlogged-title {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.unlogged-tip {
  font-size: 26rpx;
  color: #8b8b8b;
  margin-bottom: 40rpx;
}

.wechat-login-btn {
  --td-button-primary-bg-color: #07c160;
  --td-button-primary-border-color: #07c160;
  --td-button-border-radius: 24rpx;
  --td-button-large-height: 96rpx;
}

/* 画廊区域 */
.gallery-section {
  background: #ffffff;
  padding: 32rpx;
}

/* 个人画廊瀑布流（与首页一致） */
.gallery-masonry {
  display: flex;
  gap: 16rpx;
}

.gallery-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-image {
  width: 100%;
  display: block;
}

.card-info {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.author-avatar-placeholder {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.author-name {
  font-size: 24rpx;
  color: #8b8b8b;
}

.like-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-count {
  font-size: 24rpx;
  color: #a6a6a6;
}

.gallery-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.gallery-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.gallery-count {
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 画廊网格 */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.gallery-item {
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8rpx;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
  border-radius: 24rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #8b8b8b;
  text-align: center;
  margin-bottom: 32rpx;
}

.create-btn {
  --td-button-primary-bg-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --td-button-primary-border-color: transparent;
  --td-button-border-radius: 24rpx;
}

.publish-entry {
  margin-top: 32rpx;
}

.publish-entry-btn {
  --td-button-primary-bg-color: #667eea !important;
  --td-button-primary-border-color: #667eea !important;
  --td-button-border-radius: 48rpx;
  --td-button-large-height: 100rpx;
  --td-button-large-font-size: 34rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.popup-content {
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.popup-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.popup-btn {
  --td-button-border-radius: 24rpx;
  --td-button-large-height: 88rpx;
  --td-button-large-font-size: 30rpx;
}
