/**custom-tab-bar/index.wxss**/
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #eeeeee;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.tab-icon {
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #8b8b8b;
}

.tab-text.active {
  color: #667eea;
  font-weight: 500;
}
