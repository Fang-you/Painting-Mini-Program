/**app.wxss**/
page {
  --td-primary-color: #667eea;
  --td-primary-color-1: #ecf2fe;
  --td-primary-color-2: #d4e0fc;
  --td-primary-color-3: #bccffa;
  --td-primary-color-4: #a4bdf8;
  --td-primary-color-5: #8cabf6;
  --td-primary-color-6: #667eea;
  --td-primary-color-7: #5266c2;
  --td-primary-color-8: #3e4f9a;
  --td-primary-color-9: #2a3772;
  --td-primary-color-10: #16204a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
